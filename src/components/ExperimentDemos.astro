---
import ToggleButton from './ToggleButton.astro';
import ToggleSwitch from './ToggleSwitch.astro';

interface Props {
	demo:
		| 'standard-switches'
		| 'standard-buttons'
		| 'split-switch'
		| 'rocker-switch'
		| 'directional-switch'
		| 'button-group';
}

const { demo } = Astro.props;
---

{
	demo === 'standard-switches' && (
		<div class="demo demo--trio" aria-label="一般的なトグルスイッチの例">
			<div class="demo__item">
				<ToggleSwitch label="初期値がオフのトグルスイッチ" />
			</div>
			<div class="demo__item">
				<ToggleSwitch defaultOn label="初期値がオンのトグルスイッチ" />
			</div>
			<div class="demo__item">
				<ToggleSwitch disabled label="無効なトグルスイッチ" />
				<span class="demo__status">disabled</span>
			</div>
		</div>
	)
}

{
	demo === 'standard-buttons' && (
		<div class="demo demo--trio" aria-label="一般的なトグルボタンの例">
			<div class="demo__item">
				<ToggleButton label="自動保存" />
			</div>
			<div class="demo__item">
				<ToggleButton defaultOn label="自動保存" />
			</div>
			<div class="demo__item">
				<ToggleButton disabled label="自動保存" />
				<span class="demo__status">disabled</span>
			</div>
		</div>
	)
}

{
	demo === 'split-switch' && (
		<div class="demo demo--comparison" aria-label="非冪等なトグルスイッチと冪等なトグルスイッチの比較">
			<div class="comparison-cell">
				<span class="comparison-cell__label">非冪等</span>
				<ToggleSwitch label="非冪等なトグルスイッチ" />
			</div>
			<div class="comparison-cell">
				<span class="comparison-cell__label">冪等</span>
				<div
					class="split-switch"
					role="group"
					aria-label="2 つのターゲット領域から成るトグルスイッチ"
					data-widget="split-switch"
					data-state="off"
				>
					<button type="button" data-value="off" aria-label="オフにする"></button>
					<button type="button" data-value="on" aria-label="オンにする"></button>
					<span class="split-switch__knob" aria-hidden="true"></span>
					<span class="sr-only" aria-live="polite" data-state-label>オフ</span>
				</div>
			</div>
		</div>
	)
}

{
	demo === 'rocker-switch' && (
		<div class="demo demo--comparison" aria-label="非冪等なトグルスイッチとロッカースイッチ型の比較">
			<div class="comparison-cell">
				<span class="comparison-cell__label">非冪等</span>
				<ToggleSwitch label="非冪等なトグルスイッチ" />
			</div>
			<div class="comparison-cell">
				<span class="comparison-cell__label">冪等</span>
				<div
					class="rocker-switch"
					role="group"
					aria-label="ロッカースイッチ型の冪等なトグルスイッチ"
					data-widget="rocker-switch"
					data-state="off"
				>
					<button type="button" data-value="off" aria-pressed="true">OFF</button>
					<button type="button" data-value="on" aria-pressed="false">ON</button>
					<span class="sr-only" aria-live="polite" data-state-label>オフ</span>
				</div>
			</div>
		</div>
	)
}

{
	demo === 'directional-switch' && (
		<div class="demo demo--comparison" aria-label="非冪等なトグルスイッチとドラッグ操作型の比較">
			<div class="comparison-cell">
				<span class="comparison-cell__label">非冪等</span>
				<ToggleSwitch label="非冪等なトグルスイッチ" />
			</div>
			<div class="comparison-cell">
				<span class="comparison-cell__label">冪等</span>
				<button
					type="button"
					class="directional-switch"
					role="switch"
					aria-checked="false"
					aria-label="ドラッグする方向で状態を指定するトグルスイッチ"
					aria-describedby="directional-switch-hint"
					data-widget="directional-switch"
				>
					<span class="directional-switch__knob" aria-hidden="true"></span>
				</button>
				<span id="directional-switch-hint" class="comparison-cell__hint">
					左へドラッグで OFF<br />右へドラッグで ON
				</span>
			</div>
		</div>
	)
}

{
	demo === 'button-group' && (
		<div class="demo demo--comparison" aria-label="非冪等なトグルボタンと冪等なトグルボタンの比較">
			<div class="comparison-cell">
				<span class="comparison-cell__label">非冪等</span>
				<ToggleButton label="自動保存" />
			</div>
			<div class="comparison-cell">
				<span class="comparison-cell__label">冪等</span>
				<div
					class="idempotent-button-group"
					role="group"
					aria-label="自動保存"
					data-widget="button-group"
					data-state="off"
				>
					<button type="button" data-value="off" aria-pressed="true">OFF</button>
					<button type="button" data-value="on" aria-pressed="false">ON</button>
					<span class="sr-only" aria-live="polite" data-state-label>オフ</span>
				</div>
			</div>
		</div>
	)
}

<script>
	const setPressedState = (button: HTMLButtonElement): void => {
		const isPressed = button.getAttribute('aria-pressed') === 'true';
		button.setAttribute('aria-pressed', String(!isPressed));
	};

	const setSwitchState = (button: HTMLButtonElement, isOn: boolean): void => {
		button.setAttribute('aria-checked', String(isOn));
	};

	const setGroupState = (group: HTMLElement, value: 'off' | 'on'): void => {
		group.dataset.state = value;
		group.querySelectorAll<HTMLButtonElement>('button[data-value]').forEach((button) => {
			button.setAttribute('aria-pressed', String(button.dataset.value === value));
		});

		const stateLabel = group.querySelector<HTMLElement>('[data-state-label]');
		if (stateLabel) {
			stateLabel.textContent = value === 'on' ? 'オン' : 'オフ';
		}
	};

	document.querySelectorAll<HTMLButtonElement>('[data-widget="toggle-switch"]').forEach((button) => {
		button.addEventListener('click', () => {
			setSwitchState(button, button.getAttribute('aria-checked') !== 'true');
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-widget="toggle-button"]').forEach((button) => {
		button.addEventListener('click', () => setPressedState(button));
	});

	document
		.querySelectorAll<HTMLElement>(
			'[data-widget="split-switch"], [data-widget="rocker-switch"], [data-widget="button-group"]',
		)
		.forEach((group) => {
			group.querySelectorAll<HTMLButtonElement>('button[data-value]').forEach((button) => {
				button.addEventListener('click', () => {
					const value = button.dataset.value;
					if (value === 'off' || value === 'on') {
						setGroupState(group, value);
					}
				});
			});
		});

	document.querySelectorAll<HTMLButtonElement>('[data-widget="directional-switch"]').forEach((button) => {
		let pointerStartX: number | undefined;
		const DRAG_THRESHOLD_PX = 16;

		button.addEventListener('pointerdown', (event) => {
			pointerStartX = event.clientX;
			button.setPointerCapture(event.pointerId);
		});

		button.addEventListener('pointermove', (event) => {
			if (pointerStartX === undefined) {
				return;
			}

			const distance = event.clientX - pointerStartX;
			button.dataset.dragDirection =
				Math.abs(distance) < DRAG_THRESHOLD_PX ? '' : distance > 0 ? 'right' : 'left';
		});

		const finishDrag = (event: PointerEvent): void => {
			if (pointerStartX === undefined) {
				return;
			}

			const distance = event.clientX - pointerStartX;
			if (Math.abs(distance) >= DRAG_THRESHOLD_PX) {
				setSwitchState(button, distance > 0);
			}

			pointerStartX = undefined;
			delete button.dataset.dragDirection;
		};

		button.addEventListener('pointerup', finishDrag);
		button.addEventListener('pointercancel', () => {
			pointerStartX = undefined;
			delete button.dataset.dragDirection;
		});
		button.addEventListener('click', (event) => event.preventDefault());
		button.addEventListener('keydown', (event) => {
			if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') {
				return;
			}

			event.preventDefault();
			setSwitchState(button, event.key === 'ArrowRight');
		});
	});
</script>

<style>
	.demo {
		margin-block: 2rem 2.75rem;
		border: 1px solid rgb(32 32 29 / 14%);
		border-radius: 1.5rem;
		background:
			linear-gradient(rgb(32 32 29 / 4%) 1px, transparent 1px),
			linear-gradient(90deg, rgb(32 32 29 / 4%) 1px, transparent 1px),
			#faf8f2;
		background-size: 20px 20px;
		box-shadow: 0 14px 40px rgb(58 52 38 / 7%);
	}

	.demo--trio {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.5rem;
		padding: clamp(1.75rem, 5vw, 3rem);
	}

	.demo__item,
	.comparison-cell {
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.demo__item {
		flex-direction: column;
		min-height: 5rem;
	}

	.demo__status {
		margin-top: 0.6rem;
		color: #77736a;
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.demo--comparison {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		min-height: 17rem;
	}

	.comparison-cell {
		position: relative;
		flex-direction: column;
		gap: 1.25rem;
		padding: 3.75rem 1.25rem 2rem;
	}

	.comparison-cell + .comparison-cell {
		border-left: 1px dashed rgb(32 32 29 / 25%);
	}

	.comparison-cell__label {
		position: absolute;
		top: 1rem;
		padding: 0.25rem 0.65rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		background: #faf8f2;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
	}

	.comparison-cell:nth-child(2) .comparison-cell__label {
		color: #c33b1d;
	}

	.comparison-cell__hint {
		color: #666259;
		font-size: 0.68rem;
		line-height: 1.65;
		text-align: center;
	}

	:global(.toggle-switch),
	.directional-switch {
		position: relative;
		width: 4.5rem;
		height: 2.6rem;
		flex: 0 0 auto;
		cursor: pointer;
		touch-action: none;
		border: 2px solid #20201d;
		border-radius: 999px;
		background: #e4e0d5;
		box-shadow: 0 3px 0 #20201d;
		transition:
			background-color 150ms ease,
			transform 100ms ease,
			box-shadow 100ms ease;
	}

	:global(.toggle-switch:hover:not(:disabled)),
	.directional-switch:hover {
		background: #d9d4c8;
	}

	:global(.toggle-switch:active:not(:disabled)),
	.directional-switch:active {
		transform: translateY(2px);
		box-shadow: 0 1px 0 #20201d;
	}

	:global(.toggle-switch:focus-visible),
	:global(.toggle-button:focus-visible),
	.split-switch button:focus-visible,
	.rocker-switch button:focus-visible,
	.directional-switch:focus-visible,
	.idempotent-button-group button:focus-visible {
		outline: 3px solid #ff6a43;
		outline-offset: 4px;
	}

	:global(.toggle-switch[aria-checked='true']),
	.directional-switch[aria-checked='true'] {
		background: #f85f39;
	}

	:global(.toggle-switch:disabled),
	:global(.toggle-button:disabled) {
		cursor: not-allowed;
		opacity: 0.38;
	}

	:global(.toggle-switch__knob),
	.directional-switch__knob {
		position: absolute;
		top: 0.3rem;
		left: 0.3rem;
		width: 1.75rem;
		height: 1.75rem;
		border: 2px solid #20201d;
		border-radius: 50%;
		background: #fffef9;
		transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	:global(.toggle-switch[aria-checked='true'] .toggle-switch__knob),
	.directional-switch[aria-checked='true'] .directional-switch__knob {
		transform: translateX(1.85rem);
	}

	:global(.toggle-button) {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.45rem;
		padding: 0.55rem 0.85rem;
		cursor: pointer;
		border: 2px solid #20201d;
		border-radius: 0.7rem;
		color: #20201d;
		background: #fffef9;
		box-shadow: 0 3px 0 #20201d;
		font-size: 0.82rem;
		font-weight: 700;
		transition:
			color 150ms ease,
			background-color 150ms ease,
			transform 100ms ease,
			box-shadow 100ms ease;
	}

	:global(.toggle-button:active:not(:disabled)) {
		transform: translateY(2px);
		box-shadow: 0 1px 0 #20201d;
	}

	:global(.toggle-button[aria-pressed='true']) {
		color: #fff;
		background: #20201d;
	}

	:global(.toggle-button__mark) {
		display: grid;
		width: 1.1rem;
		height: 1.1rem;
		place-items: center;
		border: 1px solid currentColor;
		border-radius: 0.25rem;
		font-size: 0.68rem;
		opacity: 0;
	}

	:global(.toggle-button[aria-pressed='true'] .toggle-button__mark) {
		opacity: 1;
	}

	.split-switch {
		position: relative;
		display: grid;
		width: 4.5rem;
		height: 2.6rem;
		grid-template-columns: repeat(2, 1fr);
		border: 2px solid #20201d;
		border-radius: 999px;
		background: #e4e0d5;
		box-shadow: 0 3px 0 #20201d;
		overflow: hidden;
	}

	.split-switch[data-state='on'] {
		background: #f85f39;
	}

	.split-switch button {
		z-index: 1;
		cursor: pointer;
		border: 0;
		background: transparent;
	}

	.split-switch button + button {
		border-left: 1px dashed rgb(32 32 29 / 35%);
	}

	.split-switch__knob {
		position: absolute;
		z-index: 2;
		top: 0.3rem;
		left: 0.3rem;
		width: 1.75rem;
		height: 1.75rem;
		pointer-events: none;
		border: 2px solid #20201d;
		border-radius: 50%;
		background: #fffef9;
		transition: transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.split-switch[data-state='on'] .split-switch__knob {
		transform: translateX(1.85rem);
	}

	.rocker-switch {
		display: grid;
		width: 6.2rem;
		height: 3.5rem;
		grid-template-columns: repeat(2, 1fr);
		padding: 0.3rem;
		border: 2px solid #20201d;
		border-radius: 0.75rem;
		background: #20201d;
		box-shadow: 0 4px 0 #807b70;
		perspective: 120px;
	}

	.rocker-switch button {
		cursor: pointer;
		border: 0;
		color: #f8f5ec;
		background: #484741;
		font-size: 0.66rem;
		font-weight: 800;
		transition:
			background-color 150ms ease,
			transform 150ms ease;
	}

	.rocker-switch button:first-child {
		border-radius: 0.35rem 0 0 0.35rem;
	}

	.rocker-switch button:last-of-type {
		border-radius: 0 0.35rem 0.35rem 0;
	}

	.rocker-switch button[aria-pressed='true'] {
		color: #20201d;
		background: #ffca38;
		transform: rotateY(9deg) scale(0.96);
	}

	.directional-switch[data-drag-direction='left'] .directional-switch__knob {
		transform: translateX(-0.12rem);
	}

	.directional-switch[data-drag-direction='right'] .directional-switch__knob {
		transform: translateX(1.97rem);
	}

	.idempotent-button-group {
		display: inline-grid;
		grid-template-columns: repeat(2, 1fr);
		padding: 0.25rem;
		border: 2px solid #20201d;
		border-radius: 0.75rem;
		background: #e4e0d5;
		box-shadow: 0 3px 0 #20201d;
	}

	.idempotent-button-group button {
		min-width: 3.25rem;
		min-height: 2.35rem;
		cursor: pointer;
		border: 0;
		border-radius: 0.45rem;
		color: #67635a;
		background: transparent;
		font-size: 0.7rem;
		font-weight: 800;
		transition:
			color 150ms ease,
			background-color 150ms ease;
	}

	.idempotent-button-group button[aria-pressed='true'] {
		color: #fff;
		background: #20201d;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 540px) {
		.demo--trio {
			padding-inline: 0.75rem;
		}

		.demo--comparison {
			min-height: 15rem;
		}

		.comparison-cell {
			padding-inline: 0.6rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.toggle-switch),
		:global(.toggle-switch__knob),
		:global(.toggle-button),
		.split-switch__knob,
		.rocker-switch button,
		.directional-switch,
		.directional-switch__knob,
		.idempotent-button-group button {
			transition: none;
		}
	}
</style>
