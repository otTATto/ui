---
interface Props {
	defaultOn?: boolean;
	disabled?: boolean;
	label?: string;
}

const {
	defaultOn = false,
	disabled = false,
	label = '自動保存',
} = Astro.props;
---

<button
	type="button"
	class="toggle-button"
	aria-pressed={defaultOn ? 'true' : 'false'}
	disabled={disabled}
	data-widget="toggle-button"
>
	<span class="toggle-button__mark" aria-hidden="true">✓</span>
	{label}
</button>
